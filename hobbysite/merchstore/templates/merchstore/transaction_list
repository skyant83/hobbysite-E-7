{% extends 'base_with_login.html' %}

{% load static %}

{% block title %}Merchandise Store{% endblock %}

{% block header %}Cart{% endblock header %}
{% block content %}
    {% if request.user.is_authenticated %}
        {% regroup product_cart by product.owner as owners %}
        <h3>User's Cart</h3>
        {% for owner in owners %}
            <h4>{{ owner.grouper.name }}</h4>
            <ul>
                {% for product in owner.list %}
                    <li>
                        {{ product }}
                    </li>
                {% endfor %}
            </ul>
        {% endfor %}
    {% endif %}
{% endblock %}